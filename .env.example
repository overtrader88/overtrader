SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =====================================================
# Site
# =====================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =====================================================
# Twelve Data (Forex) - https://twelvedata.com - free tier 800 req/dia
# Necessario para analisar pares Forex (EURUSD, GBPUSD, etc.)
# Criptos via Binance nao precisam de key.
# =====================================================
# TWELVEDATA_API_KEY=088e13230298478dbb474c713f45c198

# =====================================================
# HUBLA (gateway de pagamento BR) - Sprint 5 + Plans v2
# Crie 4 produtos no HUBLA:
#   1. PRO mensal     - R$ 59
#   2. PRO anual      - R$ 600 (R$ 50/mes equivalente)
#   3. PRO+ mensal    - R$ 99
#   4. PRO+ anual     - R$ 936 (R$ 78/mes equivalente)
# Configure webhook para https://SEU-DOMINIO/api/webhooks/hubla
# =====================================================
# Secret usado pra validar HMAC do webhook (mesmo no HUBLA)
# HUBLA_WEBHOOK_SECRET=

# IDs dos produtos no HUBLA (pra mapear venda -> plano + periodo)
# HUBLA_PRODUCT_PRO_MONTHLY=
# HUBLA_PRODUCT_PRO_ANNUAL=
# HUBLA_PRODUCT_PRO_PLUS_MONTHLY=
# HUBLA_PRODUCT_PRO_PLUS_ANNUAL=

# URLs de checkout (mostradas na pagina /planos)
# HUBLA_CHECKOUT_URL_PRO_MONTHLY=https://pay.hub.la/...
# HUBLA_CHECKOUT_URL_PRO_ANNUAL=https://pay.hub.la/...
# HUBLA_CHECKOUT_URL_PRO_PLUS_MONTHLY=https://pay.hub.la/...
# HUBLA_CHECKOUT_URL_PRO_PLUS_ANNUAL=https://pay.hub.la/...

# =====================================================
# Admins (separados por virgula) - acesso a /dashboard/admin/credits
# =====================================================
ADMIN_EMAILS=jonathan.haubert@exatron.com.br

# =====================================================
# Cron jobs (Vercel Cron / pg_cron) - Sprint 6
# Secret usado pra autorizar chamadas em /api/jobs/check-alerts
# Gere com: openssl rand -hex 32
# =====================================================
CRON_SECRET=

# =====================================================
# Noticias + Sentimento Macro - Sprint 9.11
# CryptoPanic: free 500 req/dia — pegar em https://cryptopanic.com/developers/api
# NewsAPI: free 100 req/dia (dev only — pra producao precisa Business)
# =====================================================
# CRYPTOPANIC_API_KEY=
# NEWSAPI_KEY=

# =====================================================
# Telegram Bot - Sprint 6.5
# Crie via @BotFather no Telegram (sem @ na frente do username).
# Apos deploy, chame setTelegramWebhook com seu HTTPS publico.
# =====================================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=seu_bot_name
# TELEGRAM_WEBHOOK_SECRET=

# =====================================================
# LLM API (Sprint 4 - explicabilidade dos sinais via GPT-4o-mini)
# Custo: ~R$ 0,002 por análise Completa
# Free Tier: $5 grátis de créditos no signup OpenAI
# Crie em: https://platform.openai.com/api-keys
# =====================================================
OPENAI_API_KEY=sk-...
# (Alternativa futura - Claude Haiku)
# ANTHROPIC_API_KEY=sk-ant-...

# =====================================================
# Telegram Bot (Sprint 5 - alertas gratuitos)
# =====================================================
# TELEGRAM_BOT_TOKEN=
