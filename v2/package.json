{
  "name": "tradeai",
  "version": "2.0.0",
  "private": true,
  "description": "TradeAI v2 — plataforma BR de analise de trading com IA. Reescrita credibilidade-first.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter @tradeai/web dev",
    "ci": "pnpm type-check && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0"
  }
}
